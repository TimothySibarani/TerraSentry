# TerraSentry A2A proxy (local runs). On Cloud Foundry use `cf set-env`, see manifest.yml.
# The TerraSentry API the proxy calls. Use a tunnel URL when the API runs on your laptop.
TERRASENTRY_API_URL=http://localhost:8000
# Only needed when the API sets API_TOKEN (write endpoints require it).
TERRASENTRY_API_TOKEN=
COCKPIT_BASE_URL=http://localhost:3000
A2A_AGENT_MODEL=sap
# Joule's agent-request allows 60 s; reply before it does.
A2A_REPLY_BUDGET_SECONDS=40
A2A_MAX_AGENT_RUNS_PER_HOUR=10
