{
  "name": "terrasentry",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "lint:py": "uv run ruff check .",
    "format:py": "uv run ruff format .",
    "typecheck:py": "uv run pyright",
    "test:py": "uv run pytest",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:upgrade": "uv run alembic -c apps/api/alembic.ini upgrade head",
    "db:check": "uv run alembic -c apps/api/alembic.ini check",
    "gen:api": "uv run python -m terrasentry_api.export_openapi > packages/api-client/openapi.json && pnpm --filter @terrasentry/api-client gen",
    "rehearsal:prefetch": "uv run python -m terrasentry_api.rehearsal prefetch",
    "rehearsal:run": "uv run python -m terrasentry_api.rehearsal run --offline",
    "check": "pnpm lint && pnpm lint:py && pnpm typecheck && pnpm typecheck:py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "effect": "catalog:",
    "turbo": "^2.10.12"
  }
}
