# Agent runtime (applies to --model sap)
AGENT_TEMPERATURE=0
# Output cap per model call. 2048 was too small: the verifier (Claude) hit it mid-report on a live run.
AGENT_MAX_TOKENS=8192
# Retries and the read timeout for SAP AI Core calls.
AGENT_RETRY_MAX_ATTEMPTS=5
AGENT_READ_TIMEOUT_SECONDS=120

# SAP AI Core / Generative AI Hub (hackathon models), used by --model sap.
# Paste the keybroker response as ONE line (docs/sap-hackathon-resources.md section 4).
# Never commit it; .env is gitignored.
AICORE_SERVICE_KEY=
# Or set the fields individually (the shape Cloud Foundry env vars use):
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
# Deployed model names, not repo defaults. Suggested for the hackathon:
#   AICORE_MODEL_ORCHESTRATOR=anthropic--claude-4.6-sonnet
#   AICORE_MODEL_EXTRACTION=gpt-5.4
# Check with: uv run python -m terrasentry_core.agents.preflight
AICORE_MODEL_ORCHESTRATOR=
AICORE_MODEL_EXTRACTION=

# Adverse-media context (web-search model, cited findings, never a scoring input).
#   off  : tool disabled (default)
#   stub : clearly simulated result, no network, for offline demos
#   live : Sonar through SAP AI Core; reuses the AICORE_* credentials above
ADVERSE_MEDIA_MODE=off
# Deployed web-search model name. The hackathon deployment is `sonar`; the committee's sample code
# uses `sonar-pro`. The preflight tries the other name and tells you which one works.
AICORE_MODEL_MEDIA=

# Data sources
GFW_API_KEY=
GFW_API_BASE_URL=https://data-api.globalforestwatch.org
GFW_API_ORIGIN=http://localhost
GFW_TCL_DATASET=umd_tree_cover_loss
GFW_TCL_VERSION=v1.13
# Optional JSON mapping of context layer name to a verified dataset/version.
GFW_CONTEXT_RELEASES={}
GFW_RATE_LIMIT_PER_MIN=60

FIRMS_MAP_KEY=
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_RATE_LIMIT_PER_10MIN=300
FIRMS_DAY_RANGE_MAX=5

# Cache (Redis)
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=ts:cache:v1
CACHE_TTL_SECONDS=7776000
# Offline rehearsals: prime the source cache from data/fixtures and fail fast
# on a miss instead of calling an external source.
#   uv run python -m terrasentry_integrations.fixtures export --dir data/fixtures
#   uv run python -m terrasentry_integrations.fixtures prime --dir data/fixtures
CACHE_OFFLINE=false
CACHE_FIXTURES_DIR=
# ISO date that pins FIRMS end dates and GFW year windows so fixtures recorded on
# one day still resolve later. Set it to the rehearsal's --as-of for demo day.
REHEARSAL_AS_OF=

# Database — start local Postgres with `pnpm db:up`, then `pnpm db:upgrade`
# (or point this at your own Postgres before running the migration).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/terrasentry

# SAP (M7 closed loop). SAP_MODE selects the transport:
#   stub    — schema-accurate in-process stub served at /mock-sap (no credentials)
#   sandbox — API Business Accelerator Hub sandbox; needs SAP_BASE_URL + SAP_API_KEY
#   live    — tenant / BTP Integration Suite; needs the OAuth client credentials below
SAP_MODE=stub
SAP_BASE_URL=
SAP_API_KEY=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_RATE_LIMIT_PER_MIN=60

# API
API_CORS_ORIGINS=http://localhost:3000
# Shared bearer token required on every write (POST/PUT/PATCH/DELETE) when set.
# Leave empty only on a local machine; set it (and VITE_API_TOKEN) for any
# deployment others can reach. Reads stay open.
API_TOKEN=
IMPORT_MAX_BYTES=5242880
LOG_LEVEL=INFO
# Seed the synthetic suppliers/parcels into Postgres on startup when empty.
AUTO_SEED=true
SEED_DATA_DIR=data/seed
# scripted runs the agent graph offline; set to sap once AICORE_* is configured.
AGENT_MODEL=scripted
BATCH_CONCURRENCY=4
# Concurrent agent graphs in an agent-mode batch (each is several model calls).
BATCH_AGENT_CONCURRENCY=4
RUN_TIMEOUT_SECONDS=900
SSE_PING_SECONDS=15

# Web
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=
# Sent as the bearer token by the cockpit. It ships in the browser bundle, so it
# is a shared demo token, not a secret: pair it with access control on the web app.
VITE_API_TOKEN=
