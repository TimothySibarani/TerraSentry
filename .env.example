# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- AWS ---------------------------------------------------------------
AWS_REGION=ap-southeast-1
# Credentials come from your AWS profile or the hackathon account.
# Do NOT put access keys in this file.

# Bedrock model ids. Confirm what is enabled in your account and region --
# ids are region-specific and some need an inference-profile prefix.
MODEL_ORCHESTRATOR=
MODEL_EXTRACTION=

# --- Data sources ------------------------------------------------------
# Free, instant: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: https://data-api.globalforestwatch.org/
GFW_API_KEY=

# cache | gfw | local
FOREST_CHANGE_BACKEND=cache
