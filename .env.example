# AWS / Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
# Model ids are environment choices, not repo defaults: set both before --model bedrock.
# Plain model ids or cross-region inference profiles both work.
BEDROCK_MODEL_ORCHESTRATOR=
BEDROCK_MODEL_EXTRACTION=
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=2048
# Adaptive retries and explicit timeouts for the Bedrock runtime client.
AGENT_RETRY_MAX_ATTEMPTS=5
AGENT_READ_TIMEOUT_SECONDS=120
# Prompt caching is opt-in and a silent no-op below the model minimum
# (Claude Sonnet 4.5: 1024 tokens, Haiku 4.5: 4096). off | auto | anthropic.
BEDROCK_PROMPT_CACHE=off

# Data sources
GFW_API_KEY=
GFW_API_BASE_URL=https://data-api.globalforestwatch.org
GFW_API_ORIGIN=http://localhost
GFW_TCL_DATASET=umd_tree_cover_loss
GFW_TCL_VERSION=v1.13
GFW_RATE_LIMIT_PER_MIN=60

FIRMS_MAP_KEY=
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_RATE_LIMIT_PER_10MIN=300
FIRMS_DAY_RANGE_MAX=5

# Cache (Redis)
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=ts:cache:v1
CACHE_TTL_SECONDS=7776000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/terrasentry

# SAP
SAP_MODE=stub
SAP_BASE_URL=
SAP_TOKEN_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# API
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Seed the synthetic suppliers/parcels into Postgres on startup when empty.
AUTO_SEED=true
SEED_DATA_DIR=data/seed
# scripted runs the agent graph offline; set to bedrock once model access lands.
AGENT_MODEL=scripted
BATCH_CONCURRENCY=4
RUN_TIMEOUT_SECONDS=900
SSE_PING_SECONDS=15

# Web
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=
